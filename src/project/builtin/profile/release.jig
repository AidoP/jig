# optimised aggressively, without debug assertions, overflow checks or debug information: the crates are optimised
# together when linked, with fat LTO, each in a single codegen unit, and the symbols are stripped from what is linked
set codegen/opt-level 3
set codegen/debug-assertions false
set codegen/overflow-checks false
set codegen/debuginfo 0
set codegen/lto 'fat'
set codegen/codegen-units 1
set codegen/strip 'symbols'
