# unoptimised, with debug assertions, overflow checks and full debug information, and quick to compile: without LTO,
# in many codegen units, and keeping the symbols
set codegen/opt-level 0
set codegen/debug-assertions true
set codegen/overflow-checks true
set codegen/debuginfo 2
set codegen/lto 'off'
set codegen/codegen-units 256
set codegen/strip 'none'
