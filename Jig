# MSRV
set rust-version '1.95.0'
use msrv

# defaults
set codegen/opt-level 3
set clippy/pedantic 'warn'
# paths and names are quoted in messages with `{:?}`
set clippy/unnecessary_debug_formatting 'allow'
# the parsers of statements are read from start to end, and the cases of a match are kept apart where they mean
# different things, or their order matters
set clippy/too_many_lines 'allow'
set clippy/match_same_arms 'allow'
# the values which are narrowed are known to fit, such as the fields of 32-bit ELF files, and the flags of a crate are
# independent
set clippy/cast_possible_truncation 'allow'
set clippy/struct_excessive_bools 'allow'
declare targets
    type 'list'
    info 'the targets jig is built for, of which those with their standard library installed are built'
    default unique(host-target, 'x86_64-unknown-linux-musl', 'aarch64-unknown-linux-musl', 'riscv64gc-unknown-linux-musl')
declare release-target
    type 'str'
    info 'the target of the jig which is built by default, installed, and run by the integration tests'
    default host-target

# optional development configuration
@if exists('Jig.local')
use 'Jig.local'
    file

log note codegen/
    id 'codegen-options'
    quiet

# use a cross-linker for non-host targets, whose tests run where the host can run them, such as with binfmt
@for target in targets
@if {target}.has-std && get(split(target, '-'), 0) != get(split(host-target, '-'), 0)
target {target}
    override
    linker 'rust-lld'

@for target in targets
@if {target}.has-std
crate jig 'src/main.rs'
    crate-type 'bin'
    # statically linked for musl, which `riscv64gc-unknown-linux-musl` is not by default
    codegen/target-feature get([{host-target}: []], target, ['+crt-static'])
    # where the tests of the target can run
    test {target}.test
    install target == release-target
    default target == release-target

# the integration tests run jig
crate integration 'test/main.rs'
    target release-target
    test
    depends {release-target}/jig

# the performance tests time jig on large projects
crate perf 'test/perf.rs'
    target release-target
    test
    depends {release-target}/jig
